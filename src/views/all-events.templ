package views

templ AllEvents(events []EventListItem) {
	<h1>All Events</h1>
	if len(events) == 0 {
		<p>No events have been recorded.</p>
	} else {
		<a href="events.json">Download all events as JSON</a>
		<ul>
			for _, e := range events {
				<li>
					<strong>{ e.RecordedBy }</strong> { e.Tag } - { e.Value } - <time>{ e.RecordedAt }</time> - { e.Comment }
					<form method="POST" action="/mark-event-incorrect" style="display: inline;">
						<input type="hidden" name="sequence" value={ e.Sequence }/>
						<button type="submit" style="color: red; background: none; border: 1px solid red; padding: 2px 6px; cursor: pointer;" 
							onclick="return confirm('Mark this event as incorrect? This action cannot be undone.');">Mark Incorrect</button>
					</form>
				</li>
			}
		</ul>
	}
}

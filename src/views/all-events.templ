package views

templ AllEvents(events []EventListItem) {
	<h1>All Events</h1>
	if len(events) == 0 {
		<p>No events have been recorded.</p>
	} else {
		<a href="events.json">Download all events as JSON</a>
		<ul>
			for _, e := range events {
				<li>
					<strong>{ e.RecordedBy }</strong> { e.Tag } - { e.Value } - <time>{ e.RecordedAt }</time> - { e.Comment }
					if e.CanMarkAsIncorrect {
						form method="POST" action="/mark-event-incorrect" style="display: inline; margin-left: 0.5rem;" {
							input type="hidden" name="sequence" value={ e.Sequence }
							a href="#" onclick="if(confirm('Mark this event as incorrect? This action cannot be undone.')){this.closest('form').submit()};return false;" style="color: red; text-decoration: underline; cursor: pointer;" {
								Mark Incorrect
							}
						}
					}
				</li>
			}
		</ul>
	}
}

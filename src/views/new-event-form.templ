package views

func formGroupErrorClass(hasError bool) string {
	if hasError {
		return "govuk-form-group--error"
	}
	return ""
}

templ NewEventForm(existingTags []TagSuggestion, formState FormState) {
	<style nonce={ templ.GetNonce(ctx) }>
		.govuk-error-summary {
			border: 4px solid #d4351c;
			padding: 15px 20px;
			margin-bottom: 30px;
		}
		.govuk-error-summary h2 {
			margin-top: 0;
			margin-bottom: 10px;
			font-size: 1.2rem;
		}
		.govuk-error-summary a {
			color: #d4351c;
			font-weight: bold;
		}
		.govuk-form-group--error {
			border-left: 4px solid #d4351c;
			padding-left: 15px;
			margin-bottom: 20px;
		}
		.govuk-error-message {
			color: #d4351c;
			font-weight: bold;
			display: block;
			margin-bottom: 5px;
		}
	</style>
	<h1>Log New Event</h1>
	@ErrorSummary(formState)
	<form method="post">
		<div class={ formGroupErrorClass(formState.ErrorFor("tag") != "") }>
			<label for="tag">Tag:</label>
			if formState.ErrorFor("tag") != "" {
				<span id="tag-error" class="govuk-error-message">{ formState.ErrorFor("tag") }</span>
			}
			<input type="text" id="tag" name="tag" required pattern="^[a-z][a-z-]*$" value={ formState.Tag }
				if len(existingTags) > 0 { list="tag-suggestions" }
				if formState.ErrorFor("tag") != "" { aria-describedby="tag-error" }
			/>
			<small>Used to group events. Can only contain a-z and hyphens.</small>
		</div>
		if len(existingTags) > 0 {
			<datalist id="tag-suggestions">
				for _, tag := range existingTags {
					<option value={ tag.Tag }/>
				}
			</datalist>
		}
		<div class={ formGroupErrorClass(formState.ErrorFor("value") != "") }>
			<label for="value">Value (optional):</label>
			if formState.ErrorFor("value") != "" {
				<span id="value-error" class="govuk-error-message">{ formState.ErrorFor("value") }</span>
			}
			<input type="text" id="value" name="value" value={ formState.Value }
				if formState.ErrorFor("value") != "" { aria-describedby="value-error" }
			/>
			<small>Events with values can later be plotted.</small>
		</div>
		<div class={ formGroupErrorClass(formState.ErrorFor("comment") != "") }>
			<label for="comment">Comment (optional):</label>
			if formState.ErrorFor("comment") != "" {
				<span id="comment-error" class="govuk-error-message">{ formState.ErrorFor("comment") }</span>
			}
			<textarea id="comment" name="comment"
				if formState.ErrorFor("comment") != "" { aria-describedby="comment-error" }
			>{ formState.Comment }</textarea>
		</div>
		<button type="submit">Log Event</button>
	</form>
}

templ NewEventFormWithSuccessBanner(existingTags []TagSuggestion) {
	@EventRecordedBanner()
	@NewEventForm(existingTags, FormState{})
}

templ ErrorSummary(formState FormState) {
	if formState.HasErrors() {
		<div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1">
			<h2 id="error-summary-title">There is a problem</h2>
			<ul>
				for field, msg := range formState.Errors {
					<li><a href={ templ.URL("#" + field) }>{ msg }</a></li>
				}
			</ul>
		</div>
	}
}

css successBanner() {
	margin-bottom: 20px;
	border: 2px solid #00703c;
	background-color: #eaf7ed;
	padding: 15px;
	display: flex;
	align-items: flex-start;
}

css successBannerIcon() {
	flex-shrink: 0;
	width: 24px;
	height: 24px;
	margin-right: 10px;
	color: #00703c;
}

css successBannerContent() {
	flex-grow: 1;
}

css successBannerTitle() {
	margin: 0 0 5px 0;
	font-size: 1.2rem;
	font-weight: bold;
	color: #00703c;
}

css successBannerDescription() {
	margin: 0;
}

templ EventRecordedBanner() {
	<div class={ successBanner() } role="alert" aria-labelledby="success-banner-title">
		<svg class={ successBannerIcon() } viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
			<path d="M12 0a12 12 0 1 0 12 12A12.014 12.014 0 0 0 12 0zm5.707 9.293l-6.414 6.414a1 1 0 0 1-1.414 0L6.293 12.707a1 1 0 0 1 1.414-1.414L11 14.586l5.293-5.293a1 1 0 0 1 1.414 1.414z"></path>
		</svg>
		<div class={ successBannerContent() }>
			<h2 class={ successBannerTitle() } id="success-banner-title">Success</h2>
			<p class={ successBannerDescription() }>Your event was successfully recorded.</p>
		</div>
	</div>
}
